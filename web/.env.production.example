# ===== 真实 AGC 网关对接（生产/联调） =====
# 云函数 HTTP 触发器访问域名：从 AGC 控制台「云开发 > 云函数 > 触发器」获取
# 说明：agconnect-services.json 提供 region=CN、agcgw 域名（connect-drcn.dbankcloud.cn）与
# project_id/app_id 用于参考；Web 侧调用云函数请使用 AGC 云函数 HTTP 触发器域名，避免直接使用 SDK 凭据。
VITE_API_BASE_URL=https://<your-agc-cloudfunction-http-trigger-domain>
# 请求超时（毫秒）
VITE_API_TIMEOUT_MS=30000
